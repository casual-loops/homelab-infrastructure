{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized infrastructure maintenance event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "date",
    "category",
    "outcome",
    "systems",
    "validation",
    "maintenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^maintenance-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "enum": [
        "scheduled-maintenance",
        "emergency-maintenance",
        "routine-maintenance"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "partially-completed",
        "rolled-back",
        "failed"
      ]
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "hypervisors",
        "virtual_machines",
        "containers"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "hypervisors": {
          "type": "integer",
          "minimum": 0
        },
        "virtual_machines": {
          "type": "integer",
          "minimum": 0
        },
        "containers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guests_expected",
        "guests_recovered",
        "monitored_hosts_observed",
        "monitored_hosts_up",
        "service_warnings",
        "service_unknown",
        "service_critical",
        "storage_integrity_errors",
        "scheduled_log_rotation_succeeded",
        "administrative_closeout_verified"
      ],
      "properties": {
        "guests_expected": {
          "type": "integer",
          "minimum": 0
        },
        "guests_recovered": {
          "type": "integer",
          "minimum": 0
        },
        "monitored_hosts_observed": {
          "type": "integer",
          "minimum": 0
        },
        "monitored_hosts_up": {
          "type": "integer",
          "minimum": 0
        },
        "service_warnings": {
          "type": "integer",
          "minimum": 0
        },
        "service_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "service_critical": {
          "type": "integer",
          "minimum": 0
        },
        "storage_integrity_errors": {
          "type": "integer",
          "minimum": 0
        },
        "scheduled_log_rotation_succeeded": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "administrative_closeout_verified": {
          "type": "boolean"
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obsolete_kernels_removed",
        "guest_backup_archives_observed",
        "restore_tests_verified",
        "packages_upgraded",
        "maintenance_duration_minutes"
      ],
      "properties": {
        "obsolete_kernels_removed": {
          "type": "integer",
          "minimum": 0
        },
        "guest_backup_archives_observed": {
          "type": "integer",
          "minimum": 0
        },
        "restore_tests_verified": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "packages_upgraded": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maintenance_duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "packages_installed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "packages_removed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "packages_purged": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "apt_execution_duration_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "apt_systems_collected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
